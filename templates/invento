function normalizeOcrText(s){
  return String(s||'').replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d))
    .replace(/[|]/g,'/').replace(/[؛;]/g,' ').replace(/[ـ]/g,'').replace(/[\t\r]+/g,' ').replace(/ +/g,' ').trim();
}
function parseLabelText(raw){
  const t=normalizeOcrText(raw);
  // Detect shoe sizes anywhere, even when OCR misses the slash or the word "سایز".
  const sizeText=t.replace(/(?<!\d)([34])\s+([0-9])(?=\D|$)/g,'$1$2');
  const matches=[...sizeText.matchAll(/(?:^|\D)(3[5-9]|4[0-8])(?=\D|$)/g)];
  const size=matches.length?matches[matches.length-1][1]:'';
  let nameText=t;
  if(size){ const idx=t.lastIndexOf(size); nameText=(t.slice(0,idx)+t.slice(idx+size.length)).replace(/(?:سایز|size|\/|\\|:|-)+/gi,' ').trim(); }
  const lines=nameText.split(/\n+/).map(x=>x.trim()).filter(Boolean)
    .filter(x=>!(/\d{5,}/.test(x))&&!/(قیمت|تومان|ریال|price|barcode|بارکد)/i.test(x));
  let nameLine=(lines.sort((a,b)=>b.replace(/\s/g,'').length-a.replace(/\s/g,'').length)[0]||nameText).trim();
  nameLine=nameLine.replace(/^\d+\s*/,'').replace(/[\/\\:|,-]+\s*$/,'').trim();
  const generic=['بزرگپا','کتونی','کفش','مردانه','مرد','زنانه','زن','بچگانه','اسپرت','سایز','size'];
  const tokens=nameLine.split(/\s+/).filter(Boolean);
  const kept=tokens.filter(w=>!generic.some(g=>w.toLowerCase()===g.toLowerCase()));
  let color='',model='';
  if(kept.length>=2){color=kept[kept.length-1];model=kept.slice(0,-1).join(' ')}
  else {model=kept.join(' ')}
  return {model:model.trim(),color:color.trim(),size,text:t};
}
function makeOcrVariants(video){
  const variants=[];
  const vw=video.videoWidth, vh=video.videoHeight;
  // Read ONLY the red guide rectangle, ignoring surrounding box/text.
  const sx=Math.round(vw*.12), sy=Math.round(vh*.22);
  const sw=Math.round(vw*.76), sh=Math.round(vh*.56);
  const scale=Math.min(4,2200/sw);
  const c=document.createElement('canvas'); c.width=Math.round(sw*scale); c.height=Math.round(sh*scale);
  const x=c.getContext('2d',{willReadFrequently:true});
  x.imageSmoothingEnabled=true; x.imageSmoothingQuality='high';
  x.drawImage(video,sx,sy,sw,sh,0,0,c.width,c.height);
  const src=x.getImageData(0,0,c.width,c.height), d=src.data, gray=[];
  for(let i=0;i<d.length;i+=4) gray.push(.299*d[i]+.587*d[i+1]+.114*d[i+2]);
  const sorted=[...gray].sort((a,b)=>a-b); const threshold=sorted[Math.floor(sorted.length*.48)]||128;
  for(let i=0,j=0;i<d.length;i+=4,j++){
    const g=gray[j]; const contrast=Math.max(0,Math.min(255,(g-128)*1.9+128));
    d[i]=d[i+1]=d[i+2]=contrast; d[i+3]=255;
  }
  x.putImageData(src,0,0); variants.push({canvas:c,label:'فقط کادر قرمز'});
  const bw=document.createElement('canvas'); bw.width=c.width; bw.height=c.height;
  const bx=bw.getContext('2d',{willReadFrequently:true});
  const im=bx.createImageData(bw.width,bw.height), bd=im.data;
  for(let i=0,j=0;i<bd.length;i+=4,j++){
    const v=gray[j]>threshold?255:0; bd[i]=bd[i+1]=bd[i+2]=v; bd[i+3]=255;
  }
  bx.putImageData(im,0,0); variants.push({canvas:bw,label:'کادر قرمز سیاه‌وسفید'});
  return variants;
}
function ocrQuality(parsed){
  return (parsed.size?100:0)+(parsed.model?Math.min(45,parsed.model.replace(/\s/g,'').length*4):0)+(parsed.color?8:0)+(parsed.text?Math.min(15,parsed.text.length/8):0);
}
