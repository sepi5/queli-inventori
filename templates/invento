/* Qoeli Shop: Persian typography + signature purple theme */
:root{--bg:#f7f4ff;--card:#fff;--ink:#241638;--muted:#7b6b91;--line:#e9dff7;--primary:#7c3aed;--green:#087443;--red:#c0265a}
html,body,button,input,select,textarea{font-family:'Vazirmatn',Tahoma,'Segoe UI',sans-serif}
body{background:radial-gradient(ellipse at 5% 0%,#eadcff 0,transparent 34%),radial-gradient(ellipse at 100% 10%,#f3e8ff 0,transparent 32%),var(--bg);color:var(--ink)}
header{background:linear-gradient(125deg,#32105f 0%,#6421a8 53%,#8b5cf6 100%);box-shadow:0 14px 35px #6d28d926}
header p{color:#f0e5ff}
.stat,.panel{border-color:#eadff7;box-shadow:0 8px 24px #4c1d9510}
.stat{background:linear-gradient(145deg,#fff,#fcfaff)}
.stat strong{color:#6d28d9}
.tabs{border-color:#eadff7;background:#ffffffdf;box-shadow:0 8px 24px #4c1d9510}
.tab.active{background:linear-gradient(135deg,#6d28d9,#a855f7);box-shadow:0 5px 14px #7c3aed3b}
.btn:not(.secondary):not(.danger){background:linear-gradient(135deg,#6d28d9,#9333ea)}
.btn.secondary{background:#f3e8ff;color:#6b21a8;border:1px solid #e9d5ff}
input,select{border-color:#e4d7f3;background:#fdfbff}
input:focus,select:focus{border-color:#a78bfa;box-shadow:0 0 0 4px #7c3aed18}
.notice{border-color:#e9d5ff;background:#faf5ff;color:#6b21a8}
.scanbox{border-color:#c4a5f5;background:linear-gradient(145deg,#faf5ff,#fff)}
.item{border-color:#eadff7}
.itemname{color:#4c1d75}
.empty{background:#fcfaff;border-color:#e4d4f7}
.accountbar{background:rgba(49,16,95,.94)}
@media(prefers-reduced-motion:no-preference){.stat:hover,.panel:hover{box-shadow:0 12px 28px #4c1d9518}}


/* جلوگیری از زوم خودکار موبایل هنگام فوکوس روی فیلدها */
input, select, textarea, button { font-size: 16px !important; }
input[type="checkbox"], input[type="radio"] { font-size: initial !important; }

/* فونت یکسان وزیرمتن در تمام اجزای سایت؛ فقط ظاهر، بدون تغییر عملکرد */
html, body, body *, body *::before, body *::after, input, button, select, textarea, option { font-family: 'Vazirmatn', Tahoma, 'Segoe UI', sans-serif !important; }

/* Strict role isolation: render only the tabs and request panel for the signed-in role. */
body.role-admin [data-tab="profile"],
body.role-admin [data-tab="scan"],
body.role-admin [data-tab="manage"],
body.role-admin #tab-profile,
body.role-admin #tab-scan,
body.role-admin #tab-manage,
body.role-admin #sellerRequestsPanel,
body.role-admin #sellerProfileSales { display:none !important; }
body.role-seller [data-tab="upload"],
body.role-seller [data-tab="scan"],
body.role-seller [data-tab="manage"],
body.role-seller [data-tab="outgoing"],
body.role-seller [data-tab="transfers"],
body.role-seller #tab-upload,
body.role-seller #tab-scan,
body.role-seller #tab-manage,
body.role-seller #tab-outgoing,
body.role-seller #tab-transfers,
