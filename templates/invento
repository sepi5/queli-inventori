/* Modern visual refresh */
:root{
 --bg:#f3f6fc;--card:#ffffff;--ink:#17233b;--muted:#71809b;--line:#e4eaf4;
 --primary:#2563eb;--green:#059669;--red:#e53945;
}
body{
 background:radial-gradient(ellipse at 8% 0%,#dceaff 0,transparent 35%),
            radial-gradient(ellipse at 100% 8%,#e5e7ff 0,transparent 28%),var(--bg);
 color:var(--ink);font-size:14px;line-height:1.65;
}
header{
 background:linear-gradient(125deg,#101d39 0%,#17396c 58%,#2458a7 100%);
 padding:25px 18px 24px;border-radius:0 0 26px 26px;
 box-shadow:0 14px 35px #17396c24;position:relative;overflow:hidden;
}
header:after{content:"";position:absolute;width:180px;height:180px;border:1px solid #ffffff20;border-radius:50%;left:-55px;top:-80px;box-shadow:0 0 0 22px #ffffff08,0 0 0 44px #ffffff06}
header h1{font-size:25px;letter-spacing:-.4px;position:relative;z-index:1}
header p{font-size:13px;color:#d5e4ff;position:relative;z-index:1}
.wrap{max-width:900px;padding:16px 14px 28px}
.stats{gap:12px;margin-top:14px}
.stat,.panel{
 border:1px solid #e6ecf5;border-radius:19px;padding:16px;
 box-shadow:0 8px 24px #203a6610;transition:transform .18s ease,box-shadow .18s ease;
}
.stat{background:linear-gradient(145deg,#fff,#f8faff)}
.stat strong{font-size:28px;letter-spacing:-.5px;color:#1d3d73}
.stat span{font-size:12px;font-weight:600}
.panel{margin-top:14px}
.panel h2{font-size:17px;font-weight:800;letter-spacing:-.2px}
.tabs{
 position:sticky;top:8px;z-index:10;background:#ffffffd9;backdrop-filter:blur(14px);
