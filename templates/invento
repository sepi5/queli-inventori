}
.tab{border:0;background:transparent;border-radius:11px;padding:12px 7px;font-size:13px;transition:all .18s ease}
.tab.active{background:linear-gradient(135deg,#2563eb,#3988ff);box-shadow:0 5px 14px #2563eb38;color:white}
button,.btn{transition:transform .15s ease,box-shadow .15s ease,filter .15s ease}
button:active,.btn:active{transform:scale(.98)}
.btn{border-radius:12px;box-shadow:0 3px 8px #14264a0b;font-size:13px}
.btn:not(.secondary):not(.danger){background:linear-gradient(135deg,#2563eb,#3987ff)}
.btn.secondary{background:#edf4ff;color:#1d55b5;border:1px solid #dbeafe}
.btn.danger{background:linear-gradient(135deg,#e53945,#ff5964);color:#fff;border:0;box-shadow:0 5px 13px #e539452b}
input,select{border-radius:12px;border-color:#dbe3ef;background:#fbfcff;transition:border-color .15s,box-shadow .15s}
input:focus,select:focus{outline:0;border-color:#5b91f5;box-shadow:0 0 0 4px #2563eb17}
.scanbox{border:1px dashed #8eafe7;background:linear-gradient(145deg,#f5f9ff,#fff);border-radius:17px;padding:13px}
.scanbox video{max-height:310px;border:1px solid #dce6f5;box-shadow:0 8px 20px #14264a14}
.scanstate{font-size:13px}
.notice{border:1px solid #dbeafe;border-radius:12px;background:#eff6ff;color:#234b87;font-size:12px}
.list{gap:10px}
.item{border:1px solid #e4eaf4;border-radius:15px;padding:14px;box-shadow:0 4px 12px #14264a07;transition:transform .16s,box-shadow .16s}
.item:active{transform:scale(.995)}
