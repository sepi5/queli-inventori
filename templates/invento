<script>
(function(){
 let deferred=null;
 const bar=document.getElementById('pwaInstallBar'), btn=document.getElementById('pwaInstallBtn'), close=document.getElementById('pwaInstallClose'), label=document.getElementById('pwaInstallText');
 if('serviceWorker' in navigator && location.protocol==='https:'){navigator.serviceWorker.register('/sw.js').catch(function(e){console.warn('PWA service worker:',e)});}
 const isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent);
 const standalone=window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone===true;
 if(!standalone && bar){
  if(isIOS){bar.style.display='block';label.textContent='برای نصب: اشتراک‌گذاری Safari ← Add to Home Screen';btn.textContent='راهنمای نصب';btn.onclick=function(){alert('در Safari دکمه اشتراک‌گذاری را بزن و گزینه Add to Home Screen را انتخاب کن. سپس کوئلی شاپ را از آیکون صفحه اصلی باز کن.');};}
  else if(!localStorage.getItem('queliPwaInstallDismissed')){bar.style.display='block';}
 }
 window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();deferred=e;if(bar)bar.style.display='block';});
 if(btn)btn.addEventListener('click',async function(){
  if(deferred){deferred.prompt();try{await deferred.userChoice;}catch(e){}deferred=null;if(bar)bar.style.display='none';}
  else if(!isIOS)alert('از منوی مرورگر گزینه Install app یا Add to Home Screen را انتخاب کن.');
 });
 if(close)close.addEventListener('click',function(){bar.style.display='none';localStorage.setItem('queliPwaInstallDismissed','1');});
 window.addEventListener('appinstalled',function(){if(bar)bar.style.display='none';});
})();
</script>
