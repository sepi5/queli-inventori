class="seller-sales-row"><b>${esc(x.model||'—')} · ${esc(x.color||'—')} · سایز ${esc(x.size||'—')}</b><div class="sub">${fa(x.qty||0)} جفت · ${esc(x.sold_at_display||x.sold_at||'')}</div></div>`).join('')||'<div class="empty">فروشی ثبت نشده است.</div>';$('adminSellerTodayList').innerHTML=renderSales(d.today_sales);$('adminSellerRecentSales').innerHTML=renderSales(d.recent_sales)}catch(e){$('adminSellerTodayList').textContent=e.message;$('adminSellerRecentSales').textContent=''}}document.addEventListener('click',e=>{const b=e.target.closest('[data-open-seller]');if(b)openAdminSeller(b.dataset.openSeller)});$('saveSellerPassword')?.addEventListener('click',async()=>{const pw=$('adminSellerNewPassword').value;const box=$('sellerPasswordFeedback');box.classList.remove('hidden');if(pw.length<10){box.textContent='رمز عبور باید حداقل ۱۰ کاراکتر باشد.';return}const b=$('saveSellerPassword');b.disabled=true;try{const r=await fetch('/api/admin/sellers/'+activeAdminSellerId+'/password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pw})});const d=await r.json();if(!r.ok)throw new Error(d.error||'تغییر رمز ناموفق بود');box.textContent='رمز عبور فروشنده تغییر کرد.';$('adminSellerNewPassword').value=''}catch(e){box.textContent=e.message}finally{b.disabled=false}});
