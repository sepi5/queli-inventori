<script>
(()=>{'use strict';
const $=id=>document.getElementById(id); const KEY='shoe_inventory_v1'; const OUTKEY='shoe_inventory_outgoing_v1'; const IMPORTKEY='shoe_inventory_excel_19mehr_imported_v1'; const BASE_INVENTORY=[]; let inventoryLimit=100; let products=load(); let outgoing=loadOutgoing(); let scanMode='in'; let stream=null,detector=null,raf=null,lastCode='',lastAt=0,armedCode='',lastDetectedAt=0,audioCtx=null,ocrBusy=false,zxingReader=null,zxingControls=null;
function load(){
  if(Array.isArray(window.__SHOE_SERVER_STATE__?.products)){
    const shared=window.__SHOE_SERVER_STATE__.products.map(p=>({...p}));
    try{localStorage.setItem(KEY,JSON.stringify(shared));localStorage.setItem(IMPORTKEY,'1')}catch(e){}
    return shared;
  }
  let current=[];
  try{current=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){current=[]}
  try{
    if(!localStorage.getItem(IMPORTKEY)){
      for(const base of BASE_INVENTORY){
        const same=current.find(p=>(p.model||'').trim()===base.model && (p.color||'').trim()===base.color && String(p.size||'').trim()===base.size);
        if(same){same.qty=base.qty;same.sourceExcel=true;}
        else current.push({...base});
      }
      localStorage.setItem(KEY,JSON.stringify(current));
      localStorage.setItem(IMPORTKEY,'1');
    }
  }catch(e){console.warn('Excel inventory import failed',e)}
  return current;
}
function loadOutgoing(){if(Array.isArray(window.__SHOE_SERVER_STATE__?.outgoing)){try{localStorage.setItem(OUTKEY,JSON.stringify(window.__SHOE_SERVER_STATE__.outgoing));return window.__SHOE_SERVER_STATE__.outgoing.map(x=>({...x}))}catch(e){}}try{return JSON.parse(localStorage.getItem(OUTKEY)||'[]')}catch(e){return []}}
let syncQueue=Promise.resolve();function syncSharedState(){const snapshot={products:products.map(p=>({...p})),outgoing:outgoing.map(x=>({...x}))};syncQueue=syncQueue.then(()=>fetch('/api/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(snapshot)})).then(r=>{if(!r.ok)throw new Error('sync failed');window.__SHOE_SERVER_STATE__=snapshot}).catch(()=>toast('ذخیره روی سرور انجام نشد؛ اتصال را بررسی کن.'));return syncQueue}
function persistOutgoing(){localStorage.setItem(OUTKEY,JSON.stringify(outgoing));renderOutgoing();syncSharedState()}
function persist(){localStorage.setItem(KEY,JSON.stringify(products));render();syncSharedState()}
function digits(s){return String(s??'').replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d))}
function fa(n){return new Intl.NumberFormat('fa-IR').format(n)}
function toast(s){$('toast').textContent=s;$('toast').style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>$('toast').style.display='none',2600)}
function switchTab(name){if(window.__SHOE_ROLE__==='admin'&&['profile','scan','manage'].includes(name))return;if(window.__SHOE_ROLE__==='seller'&&['upload','scan','manage','outgoing','transfers'].includes(name))return;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));['scan','search','upload','manage','outgoing','transfers','requests','profile','league','sellers'].forEach(t=>{const el=$('tab-'+t);if(el)el.classList.toggle('hidden',t!==name)});if(name==='search')render(true);if(name==='outgoing'){renderOutgoing();}if(name==='transfers')renderTransfers();if(name==='requests')renderAdminRequests();if(name==='league')loadSellerLeague();if(name==='sellers')loadAdminSellers()}
function setInventoryEntryTab(which){const file=which==='file';$('inventoryEntryFilePane').classList.toggle('hidden',!file);$('inventoryEntryManualPane').classList.toggle('hidden',file);document.querySelectorAll('[data-entry-tab]').forEach(b=>b.classList.toggle('active',b.dataset.entryTab===which));}
document.querySelectorAll('[data-entry-tab]').forEach(b=>b.addEventListener('click',()=>setInventoryEntryTab(b.dataset.entryTab)));
function switchRequestSubtab(name){document.querySelectorAll('[data-request-subtab]').forEach(b=>b.classList.toggle('active',b.dataset.requestSubtab===name));$('requestSubIncoming')?.classList.toggle('hidden',name!=='incoming');$('requestSubOutgoing')?.classList.toggle('hidden',name!=='outgoing');if(name==='outgoing')renderAdminOutgoing()}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.tab==='manage'){$('pBarcode').value='';$('pModel').value='';$('pColor').value='';$('pSize').value='';$('pQty').value='0'}switchTab(b.dataset.tab)}));
function find(code){return products.find(p=>p.barcode===String(code).trim())}
function beep(){try{if(!audioCtx)audioCtx=new (window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.type='sine';osc.frequency.value=880;gain.gain.setValueAtTime(0.0001,audioCtx.currentTime);gain.gain.exponentialRampToValueAtTime(0.18,audioCtx.currentTime+0.015);gain.gain.exponentialRampToValueAtTime(0.0001,audioCtx.currentTime+0.16);osc.connect(gain);gain.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+0.17)}catch(e){}}
$('enableRequestSound')?.addEventListener('click',async()=>{try{if(!audioCtx)audioCtx=new (window.AudioContext||window.webkitAudioContext)();await audioCtx.resume();requestSoundEnabled=true;beep();$('requestSoundStatus').textContent='صدای اعلان فعال است.';if('Notification'in window&&Notification.permission==='default'){try{await Notification.requestPermission()}catch(e){}}}catch(e){$('requestSoundStatus').textContent='صدای اعلان در این مرورگر در دسترس نیست.'}});
function setScanMode(mode){scanMode=mode;$('modeIn').classList.toggle('secondary',mode!=='in');$('modeOut').classList.toggle('secondary',mode!=='out');$('modeOut').classList.toggle('danger',mode==='out');$('modeNotice').textContent=mode==='out'?'حالت خروج کالا فعال است؛ هر اسکن یک جفت کم می‌کند و در سوابق خروج ثبت می‌شود.':'حالت ورود کالا فعال است؛ هر اسکن یک جفت به موجودی اضافه می‌کند.';toast(mode==='out'?'حالت خروج کالا فعال شد.':'حالت ورود کالا فعال شد.')}
$('modeIn').addEventListener('click',()=>setScanMode('in'));$('modeOut').addEventListener('click',()=>setScanMode('out'));
function recordOutgoing(p,code){
  if(!p){toast('این بارکد در انبار ثبت نشده است؛ خروج انجام نشد.');$('scanFeedback').classList.remove('hidden');$('scanFeedback').textContent='بارکد در موجودی پیدا نشد؛ ابتدا کالا را ثبت کن.';return false}
  if((Number(p.qty)||0)<=0){toast('موجودی این کالا صفر است.');return false}
  p.qty=Number(p.qty)-1;
  outgoing.unshift({date:Date.now(),barcode:code,model:p.model||'',color:p.color||'',size:p.size||'',qty:1,managerName:(window.__SHOE_ROLE__==='admin'?(window.__SHOE_NAME__||window.__SHOE_USERNAME__||'مدیر'):'') ,managerUsername:(window.__SHOE_ROLE__==='admin'?(window.__SHOE_USERNAME__||''):'') ,description:'خروج توسط '+(window.__SHOE_NAME__||window.__SHOE_USERNAME__||'مدیر')});
  persist();persistOutgoing();beep();if(navigator.vibrate)navigator.vibrate([70,40,70]);
  $('scanFeedback').classList.remove('hidden');
  $('scanFeedback').textContent=`خروج ثبت شد: ${p.model||'مدل نامشخص'} · ${p.color||'رنگ نامشخص'} · سایز ${p.size||'نامشخص'} — مانده: ${fa(p.qty)} جفت`;
  return true;
}
function handleBarcodeScan(code,options={}){if(scanMode==='out')return recordOutgoing(find(code),String(code).trim());return addOne(code,options)}
async function enableBrowserPush(){const status=$('pushNotificationStatus'),btn=$('enablePushNotifications');if(!('serviceWorker' in navigator)||!('PushManager' in window)||!('Notification' in window)){if(status)status.textContent='این مرورگر از اعلان پوش پشتیبانی نمی‌کند.';return}try{if(location.protocol!=='https:'&&location.hostname!=='localhost'){if(status)status.textContent='برای نوتیفیکیشن خارج از سایت، اتصال HTTPS لازم است.';return}const perm=await Notification.requestPermission();if(perm!=='granted'){if(status)status.textContent='اجازه اعلان داده نشد؛ از تنظیمات مرورگر فعالش کن.';return}const keyRes=await fetch('/api/push/public-key');const keyData=await keyRes.json();if(!keyData.publicKey){if(status)status.textContent='کلید اعلان روی سرور تنظیم نشده؛ راهنمای نصب را اجرا کن.';return}const reg=await navigator.serviceWorker.register('/sw.js');let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:base64UrlToUint8Array(keyData.publicKey)});const res=await fetch('/api/push/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({subscription:sub.toJSON()})});const data=await res.json();if(!res.ok)throw new Error(data.error||'ثبت اشتراک اعلان ناموفق بود');if(status)status.textContent='اعلان مرورگر فعال شد؛ حتی وقتی سایت بسته باشد.';if(btn)btn.textContent='✅ اعلان مرورگر فعال است';toast('نوتیفیکیشن مرورگر فعال شد.')}catch(err){if(status)status.textContent=err.message||'فعال‌سازی اعلان ناموفق بود.';toast(err.message||'فعال‌سازی اعلان ناموفق بود')}}function base64UrlToUint8Array(s){const padding='='.repeat((4-s.length%4)%4),raw=atob((s+padding).replace(/-/g,'+').replace(/_/g,'/'));const out=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)out[i]=raw.charCodeAt(i);return out}if($('enablePushNotifications')&&window.__SHOE_ROLE__==='admin')$('enablePushNotifications').addEventListener('click',enableBrowserPush);
function addOne(code,options={}){code=String(code||'').trim();if(!code){toast('اول بارکد را وارد یا اسکن کن.');return}let p=find(code);if(!p){p={barcode:code,model:'',color:'',size:'',qty:1,created:Date.now()};products.push(p);persist();$('pBarcode').value=code;$('pModel').value='';$('pColor').value='';$('pSize').value='';$('pQty').value=p.qty;$('pModel').focus();if(!options.silent)toast('بارکد جدید ثبت شد؛ مشخصات مدل، رنگ و سایز را تکمیل کن.')}else{p.qty=(Number(p.qty)||0)+1;persist();if(!options.silent)toast('یک جفت اضافه شد؛ موجودی: '+fa(p.qty)+' جفت')} $('scanCode').value='';$('scanFeedback').classList.remove('hidden');$('scanFeedback').textContent=p.model?`${p.model} · ${p.color||'رنگ نامشخص'} · سایز ${p.size||'نامشخص'} — موجودی: ${fa(p.qty)} جفت`:`بارکد ${code} ثبت شد. مشخصات را در بخش «ثبت دستی» تکمیل کن.`;return p}
$('addScan').addEventListener('click',()=>handleBarcodeScan($('scanCode').value));$('scanCode').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();handleBarcodeScan($('scanCode').value)}});
$('loadCode').addEventListener('click',()=>{const code=$('scanCode').value.trim()||$('pBarcode').value.trim();if(!code){toast('اول یک بارکد وارد کن.');return}const p=find(code);$('pBarcode').value=code;if(p){$('pModel').value=p.model||'';$('pColor').value=p.color||'';$('pSize').value=p.size||'';$('pQty').value=p.qty??0;toast('مشخصات بارکد بارگذاری شد.')}else toast('بارکد جدید است؛ مشخصات را وارد کن.')});
$('saveProduct').addEventListener('click',()=>{let barcode=$('pBarcode').value.trim();const model=$('pModel').value.trim(),color=$('pColor').value.trim(),size=digits($('pSize').value.trim());if(!model){toast('نام مدل کفش اجباری است.');return}let p=barcode?find(barcode):products.find(x=>(x.model||'').trim()===model&&(x.color||'').trim()===color&&String(x.size||'').trim()===size);if(!p){barcode='ITEM-'+Date.now()+'-'+Math.random().toString(36).slice(2,7);p={barcode,model,color,size,qty:0,created:Date.now()};products.push(p)}const qty=Math.max(0,parseInt(digits($('pQty').value),10)||0);p.model=model;p.color=color;p.size=size;p.qty=qty;$('pBarcode').value=p.barcode;persist();toast('مشخصات کالا ذخیره شد.');switchTab('search')});
function render(refreshFilterOptions=false){
const total=products.reduce((s,p)=>s+(Number(p.qty)||0),0);
$('totalPairs').textContent=fa(total);
$('totalSkus').textContent=fa(products.filter(p=>(Number(p.qty)||0)>0).length);
const q=normalizeSearch($('searchInput').value);
const isSeller=window.__SHOE_ROLE__==='seller';
$('searchInput').placeholder=isSeller?'نام مدل، رنگ یا سایز کفش را جست‌وجو کن…':'برای دیدن کفش‌ها، نام مدل، رنگ یا سایز را جست‌وجو کن';
const matchingProducts=products.filter(p=>(Number(p.qty)||0)>0)
.filter(p=>!!q&&[p.model,p.color,p.size].some(v=>normalizeSearch(v).includes(q)));
